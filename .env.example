# ==========================================
# Pharmacy Management System (PMS) - Environment Variables
# ==========================================
# Copy this file to .env and configure strong production values before deployment:
# cp .env.example .env

# --- Database Configuration ---
DB_NAME=pmsdb
DB_USERNAME=pms_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_PORT=5434

# --- Spring Backend Port ---
BACKEND_PORT=8081

# --- Frontend Port ---
FRONTEND_PORT=4200

# --- JWT Security (Must be at least 256-bit / 32+ characters) ---
JWT_SECRET=REPLACE_WITH_RANDOM_SECURE_256BIT_SECRET_STRING_HERE
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Initial Seed User Passwords (Applied only on initial clean DB setup) ---
ADMIN_INITIAL_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE
PHARMACIST_INITIAL_PASSWORD=YOUR_STRONG_PHARMACIST_PASSWORD_HERE
CASHIER_INITIAL_PASSWORD=YOUR_STRONG_CASHIER_PASSWORD_HERE

# --- CORS Allowed Origins ---
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
